{
    "version": 2,
    "functions": {
        "config/wsgi.py": {
            "runtime": "python3.12",
            "maxDuration": 30
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "config/wsgi.py"
        }
    ],
    "buildCommand": "pip install -r requirements.txt && python manage.py collectstatic --noinput"
}
